# Copy to .env.local and fill in. Never commit .env.local.

# Same OpenRouter key you used in Sprint 1 / Interview Practice App.
# Without it the app runs in demo mode on deterministic fixtures.
OPENROUTER_API_KEY=sk-or-v1-...

# Optional: override the default model (any OpenRouter model id)
# OPENROUTER_MODEL=openai/gpt-4.1-mini

# Optional: LangSmith observability (Hard optional #2).
# Uncomment both to trace every canary run — the graph, per-case traces,
# judge calls, the analyst tool loop and gate decisions.
# Key from https://smith.langchain.com → Settings → API Keys.
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=promptcanary
# EU accounts: https://eu.smith.langchain.com
# LANGSMITH_ENDPOINT=https://eu.api.smith.langchain.com
