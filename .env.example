# Copy to .env.local and fill in. Never commit .env.local.

# Optional. Without it the app runs in demo mode on deterministic fixtures.
# On a public deploy, prefer pasting a key in Developer settings (tab-only).
# A server key here is rate-limited (4 live runs / IP / hour).
OPENROUTER_API_KEY=sk-or-v1-...

# Optional: override the default model (any OpenRouter model id)
# OPENROUTER_MODEL=openai/gpt-4.1-mini

# Optional: OpenRouter prompt-injection guardrail (layer 3 of the prompt screen).
# Create a guardrail at openrouter.ai → Settings → Privacy → Guardrails, enable
# Security → prompt injection (Block or Redact), assign it to this API key.
# PromptCanary probes it on every candidate; set to false to skip the probe.
# OPENROUTER_GUARDRAIL_PROBE=true

# Optional: LangSmith observability.
# Uncomment both to trace every canary run — the graph, per-case traces,
# judge calls, the analyst tool loop and gate decisions.
# Key from https://smith.langchain.com → Settings → API Keys.
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=promptcanary
# EU accounts: https://eu.smith.langchain.com
# LANGSMITH_ENDPOINT=https://eu.api.smith.langchain.com
