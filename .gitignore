# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# PromptCanary runtime state (long-term memory, decision log, live prompt)
/data

# local study guide
READINGS.md

# local tool caches
.fallow/

# red-team scan outputs (regenerated by `pnpm red-team`)
/redteam/report.json
/redteam/run.log
/redteam/output/
.promptfoo/

# AI-tooling stubs auto-generated by Next.js
AGENTS.md
CLAUDE.md
